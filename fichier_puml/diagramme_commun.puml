@startuml
title umlfactory2code – Diagramme COMMUN

package "Commun" {

class Modele {
  +id : int
  +nom : String
}

class Classe {
  +id : int
  +nom : String
}

class Attribut {
  +id : int
  +nom : String
  +type : String
}

class Methode {
  +id : int
  +nom : String
  +typeRetour : String
}

class Relation {
  +id : int
  +type : String
  +cardinaliteSource : String
  +cardinaliteCible : String
}

' ===== Relations du modèle UML =====
Modele "1" *-- "1..*" Classe : est composé de
Classe "1" *-- "0..*" Attribut : est composé de
Classe "1" *-- "0..*" Methode : est composé de
Modele "1" o-- "0..*" Relation : est agrégé de


' ===== Génération de code =====
abstract class GenerateurCode {
  +id : int
  +generer(modele : Modele) : ProjetCode
}

class ProjetCode {
  +id : int
  +nom : String
  +ecrireTous() : void
}

class FichierCode {
  +id : int
  +chemin : String
  +ecrire() : void
}

GenerateurCode --> Modele : utilise
GenerateurCode --> ProjetCode : produit

ProjetCode "1" o-- "1..*" FichierCode : est agrégé de
}

@enduml
