@startuml
title UMLFactory2Code - Diagramme Commun
skinparam classAttributeIconSize 0

package "Couche Generateur" {

  class ConvertisseurUmlVersCode {
    +cheminEntree : {ID} String
    +cheminSortie : {ID} String
    ---
    +convertir(DiagrammeClasse, Generateur) : List<File>
  }

  abstract class Generateur {
    +langage : {ID} LangageSortie
    ---
    +genererClasse2Langage(DiagrammeClasse) : List<File>
    +genererBlocCommentaire() : String
  }

  enum LangageSortie {
    JAVA
    CPP
    PYTHON
  }

  interface Commentaire {
    +genererBlocCommentaire() : String
  }

  Generateur ..|> Commentaire
  ConvertisseurUmlVersCode "1" o-- "0..1" DiagrammeClasse : "diagramme a convertir"
  ConvertisseurUmlVersCode "1" *-- "1..*" Generateur : "generateurs"
}

package "UML" {

  class DiagrammeClasse {
    +nom : {ID} String
    -classes : List<Classe>
    ---
    +getListeClasses() : List<Classe>
  }

  class "Classe" as UMLClasse {
    +nom : {ID} String
    +estAbstraite : Boolean
    +estInterface : Boolean
    -attributs : List<Attribut>
    -operations : List<Operation>
    -relations : List<Relation>
    -notes : List<String>
    ---
    +getAttributs() : List<Attribut>
    +getOperations() : List<Operation>
    +getRelations() : List<Relation>
    +ajouterNotes(String) : void
  }

  class Attribut {
    +nom : {ID} String
    +type : String
    +visibilite : Visibilite
  }

  class Operation {
    +nom : {ID} String
    +typeRetour : String
    +visibilite : Visibilite
    -notes : List<String>
    ---
    +ajouterNotes(String) : void
  }

  abstract class Relation {
    +idRelation : {ID} String
    +cardinaliteSource : String
    +roleSource : String
    +cardinaliteCible : String
    +roleCible : String
    -notes : List<String>
    ---
    +ajouterNotes(String) : void
  }

  class Composition {
  }

  class Agregation {
  }

  class Heritage {
  }

  enum Visibilite {
    PUBLIC
    PRIVE
    PROTEGE
    PAQUETAGE
  }

  interface Notes {
    +ajouterNotes(String) : void
  }

  ' --- Heritages ---
  Relation <|-- Composition
  Relation <|-- Agregation
  Relation <|-- Heritage

  ' --- Implementations de Notes ---
  UMLClasse ..|> Notes
  Operation ..|> Notes
  Relation ..|> Notes

  ' --- Compositions internes ---
  DiagrammeClasse "1" *-- "0..*" UMLClasse : "classes"
  UMLClasse "1" *-- "0..*" Attribut : "attributs"
  UMLClasse "1" *-- "0..*" Operation : "operations"

  ' --- Agregation : une relation lie 2 classes ---
  UMLClasse "2" o-- "0..*" Relation : "relations sortantes"
}

package "Parseur" {

  class ParseurPuml {
    +cheminFichier : {ID} String
    -contenu : String
    ---
    +parser() : DiagrammeClasse
  }

  ParseurPuml "1" *-- "0..1" DiagrammeClasse : "produit"
}

' --- Heritages vers les generateurs specialises ---
Generateur <|-- GenerateurJava
Generateur <|-- GenerateurCpp
Generateur <|-- GenerateurPython

note "Classe specialisee\nvoir diagramme specialise" as N1
N1 -- GenerateurJava
N1 -- GenerateurCpp
N1 -- GenerateurPython

@enduml
