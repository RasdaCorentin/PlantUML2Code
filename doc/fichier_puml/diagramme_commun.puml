@startuml
skinparam classAttributeIconSize 0

class Executeur {
  +cheminEntree : {ID} String
  +langage : LangageSortie
  +lancerTransformation(GroupeClass) : File
}

class ConvertisseurUmlVersCode {
  +convertir(classe: Classe, langage: LangageSortie) : String
}

package "Couche Analyse" {
  class DiagrammeClasse {
    +nom : {ID} String
    +getListeClasses() : List<Classe>
  }
}

package UML {
  class "Classe" as UMLClasse {
    +nom : {ID} String
    +estAbstraite : Boolean
    +estInterface : Boolean
    ---
    +getAttributs() : List<Attribut>
    +getOperations() : List<Operation>
    +getRelations() : List<(Classe,Classe,Relation)>
  }

  UMLClasse "1" *-- "0..*" Attribut
  UMLClasse "1" *-- "0..*" Operation
  UMLClasse "2" o-- "0..*" Relation  : "{Liste des relations sortantes}"

  enum Visibilite {
    PUBLIC
    PRIVE
    PROTEGE
    PAQUETAGE
  }

  class Attribut {
    +nom : {ID} String
    +type : String
    +visibilite : Visibilite
  }

  class Operation {
    +nom : {ID} String
    +typeRetour : String
    +visibilite : Visibilite
  }

  class Relation {
    +idRelation : {ID} String
    +cardinaliteSource : int
    +roleSource : String
    +cardinaliteCible : int
    +roleCible : String
  }

  enum Type {
    UML
    CPP
  }

  enum Position {
    NOTES_CLASSE
    NOTES_OPERATION
    NOTES_RELATION
    NOTES_GRPCLASSE
  }

  interface Notes {
    +emplacement : Position
    +contenu : String
  }

  UMLClasse ..|> Notes
  Relation ..|> Notes
  Operation ..|> Notes
}

UMLClasse "0..1" --* "1..*" DiagrammeClasse

package "Couche Generation" {
  abstract class Generateur {
    +cheminSortie : {ID} String
    +genererCode(DiagrammeClasse) : File
    +genererClasse(classe: Classe) : String
  }

  class GenerateurJava {
    +genererCode(DiagrammeClasse) : File
    +genererClasse(classe: Classe) : String
  }

  class GenerateurCpp {
    +genererCode(DiagrammeClasse) : File
    +genererClasse(classe: Classe) : String
  }

  class GenerateurPython {
    +genererCode(DiagrammeClasse) : File
    +genererClasse(classe: Classe) : String
  }

  class GenerateurRust {
    +genererCode(DiagrammeClasse) : File
    +genererClasse(classe: Classe) : String
  }

  enum LangageSortie {
    JAVA
    CPP
    PYTHON
    RUST
  }

  interface Commentaire {
    +contenu : {ID} String
    +genererBlocCommentaire() : String
  }

  Generateur ..|> Commentaire
}

Executeur "1" o-- "0..1" DiagrammeClasse
Executeur "1" o-- "0..*" Generateur
Executeur "1" o-- "0..1" ConvertisseurUmlVersCode

ConvertisseurUmlVersCode ..> Generateur
ConvertisseurUmlVersCode ..> UMLClasse

Generateur <|-- GenerateurJava
Generateur <|-- GenerateurCpp
Generateur <|-- GenerateurPython
Generateur <|-- GenerateurRust

package Cpp {
  class ClasseCpp {
    +nom : {ID} String
  }
}

UMLClasse <|-- ClasseCpp

@enduml