@startuml
title UMLFactory2Code - Extension Python (Enzo POIRIER)

skinparam classAttributeIconSize 0
top to bottom direction

package "Modèle UML (utilisé par le GenerateurPython)" {

  enum LangageSortie {
    JAVA
    CPP
    PYTHON
  }

  enum Visibilite {
    PUBLIC
    PRIVE
    PROTEGE
    PAQUETAGE
  }

  interface Notes {
    +ajouterNotes(texte : String) : void
  }

  class Classe {
    +nom : {ID} String
    +estAbstraite : Boolean
    +estInterface : Boolean
    +attributs : List<Attribut>
    +operations : List<Operation>
    +relationsSortantes : List<Relation>
    +ecrireClasse(fichier : FichierCodePython) : void
    +formaterOperation(operation : Operation) : String
    +formaterAttribut(attribut : Attribut) : String
  }

  class Attribut {
    +nom : {ID} String
    +type : String
    +visibilite : Visibilite
  }

  class Operation {
    +nom : {ID} String
    +typeRetour : String
    +visibilite : Visibilite
  }

  abstract class Relation {
    +idRelation : {ID} String
    +cardinaliteSource : int
    +roleSource : String
    +cardinaliteCible : int
    +roleCible : String
    +toPython() : String
  }

  class Heritage {
    +modeHeritage : String
    +toPython() : String
  }

  class Composition {
    +toPython() : String
  }

  class Agregation {
    +toPython() : String
  }

  Relation <|-- Heritage
  Relation <|-- Composition
  Relation <|-- Agregation

  abstract class Generateur {
    +langage : {ID} LangageSortie
    +genererCode() : File
    +genererClasse(classe : Classe) : String
  }

  class GenerateurPython {
    +langage : {ID} LangageSortie
    +genererCode() : File
    +genererClasse(classe : Classe) : String
  }

  class FichierCodePython {
    +nomFichier : {ID} String
    +contenu : String
    +ajouterLigne(ligne : String) : void
    +sauvegarder() : File
  }

  class ConvertisseurUmlVersCode {
    +cheminEntree : {ID} String
    +cheminSortie : {ID} String
    +convertir(langage : LangageSortie) : String
  }

  Classe "1" *-- "0..*" Attribut : attributs
  Classe "1" *-- "0..*" Operation : operations
  Classe "1" o-- "0..*" Relation : relationsSortantes

  Classe ..|> Notes
  Relation ..|> Notes
  Operation ..|> Notes

  Generateur <|-- GenerateurPython

  GenerateurPython "1" o-- "0..*" FichierCodePython : ecritDans

FichierCodePython "1" --> "1..*" Classe : contientCodeDe

  ConvertisseurUmlVersCode ..> Generateur : selectionne
}

@enduml